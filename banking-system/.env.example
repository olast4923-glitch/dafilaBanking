# Copy to .env locally, or set these as GitHub Codespaces secrets.
# Never commit real credentials. If these are absent the app falls back to H2 in-memory.

# Supabase: Project Settings > Database > Connection string > Session pooler (IPv4 friendly).
# Keep ?sslmode=require on the URL.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-XXXXX.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.XXXXXXXXXXXX
SUPABASE_DB_PASSWORD=your-database-password

# Optional: force any JDBC URL (used by the integration tests).
# DB_URL=jdbc:h2:mem:banking;DB_CLOSE_DELAY=-1
